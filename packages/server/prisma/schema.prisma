generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  ourPrice  Float
  currency  String   @default("USD")
  // ibranson.com's own show page for this product, e.g.
  // "https://ibranson.com/shows-in-branson-missouri/hughes-music-show/" — the
  // page the checkout-price-quote adapter drives through add-to-cart. Null
  // until someone's confirmed the real URL; only set for products piloting
  // checkout-price discovery so far.
  checkoutUrl String?
  createdAt DateTime @default(now())

  competitorPrices CompetitorPrice[]
  trackedSites      ProductSite[]
  checkoutQuotes    CheckoutQuote[]
}

model CompetitorSite {
  id        String   @id @default(cuid())
  name      String
  kind      String // "api" | "scraper" | "mock"
  // "direct" (Branson ticket/travel competitor), "ota" (national/international
  // booking platform), "info" (tourism/chamber site, may not sell tickets),
  // "demo" (simulated data for local demoing), "other"
  category  String   @default("other")
  targetUrl String
  selector  String
  // JSON checkout-automation config for driving this site's own add-to-cart
  // checkout flow — null until someone's captured this site's real checkout
  // markup and it's been wired up. Independent of `selector` (which is only
  // for the listing-price scrape). Which JSON shape checkoutSelector holds
  // depends on checkoutKind.
  checkoutSelector String?
  // "pageflow" (CheckoutConfig, adapters/checkoutAdapter.ts — separate page
  // navigations per step, like ibranson.com) | "sidecart" (SidecartCheckout
  // Config, adapters/sidecartCheckoutAdapter.ts — one in-page widget panel,
  // no navigation, like branson.com). Null until checkoutSelector is set.
  checkoutKind     String?
  // Operator-facing setup notes, e.g. "needs CSS selector" or "use partner API".
  notes     String?
  createdAt DateTime @default(now())

  competitorPrices CompetitorPrice[]
  trackedProducts   ProductSite[]
  checkoutQuotes    CheckoutQuote[]
}

// Join table: which competitor sites should be checked for which product,
// and what that product's page/identifier looks like on that site.
model ProductSite {
  id               String @id @default(cuid())
  productId        String
  competitorSiteId String
  // Per-product override of the URL to fetch on this site (e.g. the specific
  // product page). Falls back to the site's targetUrl if empty.
  url              String @default("")
  // This product's base show page on this competitor's site (no date), for
  // the checkout-price-quote adapter to drive through — the competitor
  // equivalent of Product.checkoutUrl. Null until configured.
  checkoutUrl      String?

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorSite CompetitorSite @relation(fields: [competitorSiteId], references: [id], onDelete: Cascade)

  @@unique([productId, competitorSiteId])
}

model CompetitorPrice {
  id               String   @id @default(cuid())
  productId        String
  competitorSiteId String
  price            Float?
  currency         String   @default("USD")
  fetchedAt        DateTime @default(now())
  ok               Boolean  @default(true)
  error            String?

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorSite CompetitorSite @relation(fields: [competitorSiteId], references: [id], onDelete: Cascade)

  @@index([productId, competitorSiteId, fetchedAt])
}

// A discovered all-in checkout total for buying `quantity` tickets of one
// product, via a real add-to-cart -> cart checkout run rather than the
// "starting at" rate shown on a listing page. Manually triggered from the
// checkout-pricing dashboard page, not part of the regular cron price-check
// cycle (a headless-browser checkout run per quantity is much heavier than a
// listing scrape).
model CheckoutQuote {
  id               String  @id @default(cuid())
  productId        String
  // Which competitor site this was run against — null means it was run
  // against our own site (ibranson.com), using Product.checkoutUrl instead
  // of a ProductSite.checkoutUrl.
  competitorSiteId String?
  quantity  Int
  subtotal  Float?
  taxesFees Float?
  total     Float?
  currency  String   @default("USD")
  fetchedAt DateTime @default(now())
  ok        Boolean  @default(true)
  error     String?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorSite CompetitorSite? @relation(fields: [competitorSiteId], references: [id], onDelete: Cascade)

  @@index([productId, competitorSiteId, quantity, fetchedAt])
}
