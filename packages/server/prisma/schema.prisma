generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  ourPrice  Float
  currency  String   @default("USD")
  // ibranson.com's own show page for this product, e.g.
  // "https://ibranson.com/shows-in-branson-missouri/hughes-music-show/" — the
  // page the checkout-price-quote adapter drives through add-to-cart. Null
  // until someone's confirmed the real URL; only set for products piloting
  // checkout-price discovery so far.
  checkoutUrl String?
  createdAt DateTime @default(now())

  competitorPrices CompetitorPrice[]
  trackedSites      ProductSite[]
  checkoutQuotes    CheckoutQuote[]
}

model CompetitorSite {
  id        String   @id @default(cuid())
  name      String
  kind      String // "api" | "scraper" | "mock"
  // "direct" (Branson ticket/travel competitor), "ota" (national/international
  // booking platform), "info" (tourism/chamber site, may not sell tickets),
  // "demo" (simulated data for local demoing), "other"
  category  String   @default("other")
  targetUrl String
  selector  String
  // Operator-facing setup notes, e.g. "needs CSS selector" or "use partner API".
  notes     String?
  createdAt DateTime @default(now())

  competitorPrices CompetitorPrice[]
  trackedProducts   ProductSite[]
}

// Join table: which competitor sites should be checked for which product,
// and what that product's page/identifier looks like on that site.
model ProductSite {
  id               String @id @default(cuid())
  productId        String
  competitorSiteId String
  // Per-product override of the URL to fetch on this site (e.g. the specific
  // product page). Falls back to the site's targetUrl if empty.
  url              String @default("")

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorSite CompetitorSite @relation(fields: [competitorSiteId], references: [id], onDelete: Cascade)

  @@unique([productId, competitorSiteId])
}

model CompetitorPrice {
  id               String   @id @default(cuid())
  productId        String
  competitorSiteId String
  price            Float?
  currency         String   @default("USD")
  fetchedAt        DateTime @default(now())
  ok               Boolean  @default(true)
  error            String?

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorSite CompetitorSite @relation(fields: [competitorSiteId], references: [id], onDelete: Cascade)

  @@index([productId, competitorSiteId, fetchedAt])
}

// A discovered all-in checkout total for buying `quantity` tickets of one
// product on our own site (ibranson.com), via a real add-to-cart -> cart
// checkout run rather than the "starting at" rate shown on the listing page.
// Manually triggered from the checkout-pricing dashboard page, not part of
// the regular cron price-check cycle (a headless-browser checkout run per
// quantity is much heavier than a listing scrape).
model CheckoutQuote {
  id        String   @id @default(cuid())
  productId String
  // Which site this was run against — always "iBranson" for now (our own
  // checkout), but kept as a string rather than hardcoded so a competitor's
  // checkout flow can reuse this same model later without a schema change.
  siteName  String   @default("iBranson")
  quantity  Int
  subtotal  Float?
  taxesFees Float?
  total     Float?
  currency  String   @default("USD")
  fetchedAt DateTime @default(now())
  ok        Boolean  @default(true)
  error     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, siteName, quantity, fetchedAt])
}
